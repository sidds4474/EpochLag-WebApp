NEXT_PUBLIC_API_URL=https://dev.epochlag.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps / Places (New). Required by: Lags › Places map, the Location
# picker in the story composer, and the onboarding location step. Without it
# the map is blank and location search shows a raw Google error.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Base URL used when building public story links (e.g. https://epochlag.com).
NEXT_PUBLIC_PUBLIC_STORY_BASE=

# Note: next.config.mjs also accepts NEXT_PUBLIC_API_UPSTREAM as an alias for
# NEXT_PUBLIC_API_URL (above) — they mean the same thing. The app and README use
# NEXT_PUBLIC_API_URL.

# Analytics (Google Analytics + Meta pixel). OFF unless this is exactly "true".
# Set to true ONLY on the live production deployment — leaving it unset on local,
# preview, and the dev site keeps test traffic out of the real numbers.
NEXT_PUBLIC_ENABLE_ANALYTICS=
